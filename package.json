{
  "name": "caimawaru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --",
    "build": "tsc && tsc -p tsconfig.node.json && vite build --",
    "preview": "vite preview --",
    "editor": "vite --config vite.editor.config.ts",
    "build:editor": "tsc && tsc -p tsconfig.node.json && vite build --config vite.editor.config.ts",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "同人誌即売会のサークルリスト・配置図ページを、イベントごとの設定とCSVから作る静的サイト"
}
